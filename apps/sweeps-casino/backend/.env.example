# Local/dev only. Real secrets belong in the environment's secret manager, never in source control.

NODE_ENV=local
PORT=4000

DATABASE_URL=postgresql://sweeps:sweeps@localhost:5432/sweeps_casino?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGIN=http://localhost:3100

# States seeded ALLOWED for local/demo use; every other state seeds REGISTRATION_DISABLED.
DEMO_ALLOWED_STATES=NJ,PA

# Mock provider webhook signature secrets (Phase 1 — swapped for real vendor secrets in Phase 3).
KYC_WEBHOOK_SECRET=dev-kyc-webhook-secret
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret
