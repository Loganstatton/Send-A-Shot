# ─────────────────────────────────────────────────────────────
# Sienna Studio — environment variables
# Copy to .env.local (local dev) or set in your host's dashboard.
# Nothing here is ever sent to the browser.
# ─────────────────────────────────────────────────────────────

# Password that protects the whole app (UI + API). STRONGLY recommended
# whenever the app is reachable from the internet. Leave empty only for
# local use on a trusted network.
APP_PASSWORD=

# Secret used to sign the login cookie. Any long random string.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Default ComfyUI server URL (no trailing slash). Can also be set or
# overridden in the app's Setup Wizard / Settings screen.
#   Cloud GPU (any provider): the HTTPS URL your provider/tunnel gives for port 8188
#   Own PC:   http://192.168.1.50:8188  or your Tailscale IP
#   Mock:     mock   (offline test mode, generates placeholder images)
COMFYUI_URL=mock

# Optional: credential for a ComfyUI that sits behind an auth proxy.
# Sent as  Authorization: Bearer <COMFYUI_API_KEY>
COMFYUI_API_KEY=

# Optional: extra headers as JSON, e.g. for basic-auth or Cloudflare Access:
# COMFYUI_EXTRA_HEADERS={"CF-Access-Client-Id":"...","CF-Access-Client-Secret":"..."}
COMFYUI_EXTRA_HEADERS=

# Set to "true" ONLY if the model, LoRA, GPU host and your deployment all
# permit adult (18+) synthetic content. When false, the app forces SFW mode
# and adds NSFW terms to every negative prompt.
ALLOW_ADULT_CONTENT=false

# Where profiles, workflows, presets, history and images are stored.
# Must be a persistent disk in production.
DATA_DIR=./data
