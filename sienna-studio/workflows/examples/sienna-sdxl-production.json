{
  "1": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "sdxl_base.safetensors" }, "_meta": { "title": "Base Checkpoint (SDXL)" } },
  "2": {
    "class_type": "LoraLoader",
    "inputs": { "model": ["1", 0], "clip": ["1", 1], "lora_name": "sienna_v1.safetensors", "strength_model": 0.8, "strength_clip": 0.8 },
    "_meta": { "title": "Sienna LoRA" }
  },
  "3": { "class_type": "CLIPTextEncode", "inputs": { "text": "positive prompt", "clip": ["2", 1] }, "_meta": { "title": "Positive Prompt" } },
  "4": { "class_type": "CLIPTextEncode", "inputs": { "text": "negative prompt", "clip": ["2", 1] }, "_meta": { "title": "Negative Prompt" } },

  "10": { "class_type": "LoadImage", "inputs": { "image": "example.png" }, "_meta": { "title": "Sienna Face Reference" } },
  "11": {
    "class_type": "IPAdapterUnifiedLoaderFaceID",
    "inputs": { "model": ["2", 0], "preset": "FACEID PLUS V2", "lora_strength": 0.6, "provider": "CUDA" },
    "_meta": { "title": "IPAdapter FaceID Loader" }
  },
  "12": {
    "class_type": "IPAdapterFaceID",
    "inputs": {
      "model": ["11", 0], "ipadapter": ["11", 1], "image": ["10", 0],
      "weight": 0.8, "weight_faceidv2": 1.0, "weight_type": "linear", "combine_embeds": "concat",
      "start_at": 0, "end_at": 1, "embeds_scaling": "V only"
    },
    "_meta": { "title": "IPAdapter FaceID (identity)" }
  },

  "20": { "class_type": "LoadImage", "inputs": { "image": "example.png" }, "_meta": { "title": "Pose Image (OpenPose skeleton)" } },
  "21": { "class_type": "ControlNetLoader", "inputs": { "control_net_name": "sdxl_openpose.safetensors" }, "_meta": { "title": "Pose ControlNet" } },
  "22": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": { "positive": ["3", 0], "negative": ["4", 0], "control_net": ["21", 0], "image": ["20", 0], "strength": 0.65, "start_percent": 0, "end_percent": 0.8 },
    "_meta": { "title": "Apply Pose ControlNet" }
  },

  "30": { "class_type": "LoadImage", "inputs": { "image": "example.png" }, "_meta": { "title": "Init Image (img2img)" } },
  "31": {
    "class_type": "ImageScale",
    "inputs": { "image": ["30", 0], "upscale_method": "lanczos", "width": 832, "height": 1216, "crop": "center" },
    "_meta": { "title": "Resize Init Image" }
  },
  "32": { "class_type": "VAEEncode", "inputs": { "pixels": ["31", 0], "vae": ["1", 2] }, "_meta": { "title": "Encode Init Image" } },
  "33": { "class_type": "EmptyLatentImage", "inputs": { "width": 832, "height": 1216, "batch_size": 1 }, "_meta": { "title": "Empty Latent (txt2img)" } },

  "40": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["12", 0], "positive": ["22", 0], "negative": ["22", 1], "latent_image": ["32", 0],
      "seed": 0, "steps": 30, "cfg": 5, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 1
    },
    "_meta": { "title": "KSampler" }
  },
  "41": { "class_type": "VAEDecode", "inputs": { "samples": ["40", 0], "vae": ["1", 2] }, "_meta": { "title": "VAE Decode" } },
  "42": { "class_type": "SaveImage", "inputs": { "filename_prefix": "sienna", "images": ["41", 0] }, "_meta": { "title": "Save Image" } }
}
