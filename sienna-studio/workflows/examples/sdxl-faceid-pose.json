  },
  "22": {
    "class_type": "IPAdapterFaceID",
    "inputs": {
      "model": ["20", 0],
      "ipadapter": ["20", 1],
      "image": ["21", 0],
      "weight": 0.8,
      "weight_faceidv2": 1.0,
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0,
      "end_at": 1,
      "embeds_scaling": "V only"
    },
    "_meta": { "title": "IPAdapter FaceID" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "positive prompt", "clip": ["10", 1] },
    "_meta": { "title": "Positive Prompt" }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "negative prompt", "clip": ["10", 1] },
    "_meta": { "title": "Negative Prompt" }
  },
  "30": {
    "class_type": "LoadImage",
    "inputs": { "image": "example.png" },
    "_meta": { "title": "Pose Image (OpenPose skeleton)" }
  },
  "31": {
    "class_type": "ControlNetLoader",
    "inputs": { "control_net_name": "OpenPoseXL2.safetensors" },
    "_meta": { "title": "Load ControlNet" }
  },
  "32": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["6", 0],
      "negative": ["7", 0],
      "control_net": ["31", 0],
      "image": ["30", 0],
      "strength": 0.65,
      "start_percent": 0,
      "end_percent": 0.8
    },
    "_meta": { "title": "Apply ControlNet (pose)" }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 832, "height": 1216, "batch_size": 1 },
